"""
critic_client.py — thin wrapper around the local llama-server endpoint.

Loads task-specific system prompts from /opt/persmem/critic/prompts/,
applies inference config from /opt/persmem/critic/inference.yaml,
calls llama-server's OpenAI-compatible /v1/chat/completions endpoint,
fails soft (returns structured error, no exceptions to caller).

Designed to be called from MCP tools registered in server.py.
"""

import json
import re
import time
import urllib.request
import urllib.error
from pathlib import Path

CRITIC_DIR = Path("/opt/persmem/critic")
PROMPTS_DIR = CRITIC_DIR / "prompts"
INFERENCE_CFG = CRITIC_DIR / "inference.yaml"
LLAMA_SERVER_URL = "http://127.0.0.1:8080/v1/chat/completions"

# Hard limits — we'd rather return "critic timed out" than hang an MCP call.
# N97 reality: 800-token prompt eval = ~180 sec at 4.5 tok/s; generation
# of 500-1500 tokens at 2.9 tok/s adds another 170-520 sec. Total can be
# 5-10 min per call. Default of 60 keeps quick checks tight; absolute
# of 600 gives reasoning model room to actually finish.
DEFAULT_TIMEOUT_SEC = 60
ABSOLUTE_TIMEOUT_SEC = 600


def _load_prompt(task: str) -> str:
    """Load a task-specific system prompt by name. Returns empty string on miss."""
    path = PROMPTS_DIR / f"{task}.md"
    if not path.exists():
        return ""
    return path.read_text(encoding="utf-8")


def _load_inference_config() -> dict:
    """Load inference config (yaml). Returns conservative defaults on miss."""
    defaults = {
        "temperature": 0.5,
        "top_p": 0.9,
        "repeat_penalty": 1.18,
        "max_tokens": 512,
        "stop": ["</s>", "<|im_end|>", "[/INST]", "Let me know if"],
    }
    if not INFERENCE_CFG.exists():
        return defaults
    try:
        # Tiny yaml parser — avoid pyyaml dep, format is flat key:value
        cfg = dict(defaults)
        for line in INFERENCE_CFG.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if ":" not in line:
                continue
            k, _, v = line.partition(":")
            k = k.strip()
            v = v.strip()
            # Try to coerce types
            if v.startswith("[") and v.endswith("]"):
                cfg[k] = [s.strip().strip('"').strip("'") for s in v[1:-1].split(",") if s.strip()]
            elif v.replace(".", "", 1).replace("-", "", 1).isdigit():
                cfg[k] = float(v) if "." in v else int(v)
            else:
                cfg[k] = v.strip('"').strip("'")
        return cfg
    except Exception:
        return defaults


# Regex patterns for the two ID formats used in persMEM:
# - AMQ message IDs: "20260507T020617-543446_knot_ee3ccc72"
# - Memory IDs: "mem-9083367e98cd7fd6"
# Patterns are intentionally loose to catch plausibly-formatted hallucinations
# (e.g., the model invents "20260507T013849" without the trailing hash — still
# matches as a fragment we can verify against the input).
_AMQ_ID_RE = re.compile(r"\d{8}T\d{6}(?:-\d+_[a-z]+_[a-f0-9]+)?")
_MEM_ID_RE = re.compile(r"mem-[a-f0-9]{8,32}")


def _find_hallucinated_ids(observation: str, user_input: str) -> list[str]:
    """
    Find any ID-format strings in the observation that don't appear verbatim
    in the user_input. These are likely model hallucinations.

    Returns deduplicated list of hallucinated IDs (empty list if none found).
    Verbatim substring match is intentional — fuzzy matching would mask
    actual fabrications (e.g., model emits "mem-aaaaaaaaaaaaaaaa" plausibly
    but it doesn't exist; we want to surface that).
    """
    found = set()
    for pattern in (_AMQ_ID_RE, _MEM_ID_RE):
        for match in pattern.findall(observation):
            if match not in user_input:
                found.add(match)
    return sorted(found)


def call_critic(task: str, user_input: str, timeout: int = DEFAULT_TIMEOUT_SEC) -> dict:
    """
    Run a critic task against the local llama-server.

    Args:
        task: prompt name without extension (e.g., 'batch_review', 'chorus_health', 'memory_triage')
        user_input: the actual content to critique (AMQ rounds, recent memories, etc.)
        timeout: hard upper bound in seconds. Capped at ABSOLUTE_TIMEOUT_SEC.

    Returns:
        dict with keys:
          status: 'ok' | 'timeout' | 'error' | 'no_observation'
          observation: str (the critic's output) — only present if status='ok'
          error: str (description) — only present if status in ('timeout', 'error')
          latency_sec: float (always present)
          task: str (echo of input task)
    """
    timeout = min(max(timeout, 1), ABSOLUTE_TIMEOUT_SEC)
    started = time.time()

    system_prompt = _load_prompt(task)
    if not system_prompt:
        return {
            "status": "error",
            "error": f"prompt file not found: {task}.md",
            "latency_sec": time.time() - started,
            "task": task,
        }

    cfg = _load_inference_config()

    payload = {
        "model": "ministral-3-8b-reasoning-abliterated-Q8_0",
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_input},
        ],
        "temperature": cfg.get("temperature", 0.5),
        "top_p": cfg.get("top_p", 0.9),
        "repeat_penalty": cfg.get("repeat_penalty", 1.18),
        "max_tokens": cfg.get("max_tokens", 512),
        "stream": False,
    }
    if cfg.get("stop"):
        payload["stop"] = cfg["stop"]

    req = urllib.request.Request(
        LLAMA_SERVER_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8")
        data = json.loads(body)
        choices = data.get("choices", [])
        if not choices:
            return {
                "status": "error",
                "error": "llama-server returned no choices",
                "latency_sec": time.time() - started,
                "task": task,
            }
        observation = choices[0].get("message", {}).get("content", "").strip()

        # Strip any [THINK]...[/THINK] reasoning blocks the model emitted
        # (we want the observation, not the chain-of-thought)
        if "[/THINK]" in observation:
            observation = observation.split("[/THINK]", 1)[1].strip()
        if "[THINK]" in observation:
            # Unbalanced — likely the entire response was thinking, no answer
            observation = ""

        if not observation or observation.lower() in ("no observation", "no observation."):
            return {
                "status": "no_observation",
                "latency_sec": time.time() - started,
                "task": task,
            }

        # Verify any cited IDs against the input — catch hallucinations.
        # Small models (8B) confabulate plausibly-formatted identifiers.
        # We don't strip them automatically (the caller may want to see
        # the raw observation) but we surface them as a warning.
        hallucinated = _find_hallucinated_ids(observation, user_input)

        result = {
            "status": "ok",
            "observation": observation,
            "latency_sec": time.time() - started,
            "task": task,
        }
        if hallucinated:
            result["hallucinated_ids"] = hallucinated
            result["warning"] = (
                f"Observation cites {len(hallucinated)} identifier(s) not present in input — "
                f"likely model hallucination. See hallucinated_ids field."
            )
        return result

    except urllib.error.URLError as e:
        # Includes timeouts (socket.timeout subclass)
        msg = str(e.reason) if hasattr(e, "reason") else str(e)
        is_timeout = "timed out" in msg.lower() or "timeout" in msg.lower()
        return {
            "status": "timeout" if is_timeout else "error",
            "error": msg,
            "latency_sec": time.time() - started,
            "task": task,
        }
    except Exception as e:
        return {
            "status": "error",
            "error": f"{type(e).__name__}: {e}",
            "latency_sec": time.time() - started,
            "task": task,
        }


def critic_health() -> dict:
    """Quick liveness check — returns ok if llama-server responds within 5sec."""
    started = time.time()
    try:
        with urllib.request.urlopen("http://127.0.0.1:8080/health", timeout=5) as resp:
            body = resp.read().decode("utf-8")
        data = json.loads(body) if body else {}
        return {
            "status": "ok",
            "server_status": data.get("status", "unknown"),
            "latency_sec": time.time() - started,
        }
    except Exception as e:
        return {
            "status": "down",
            "error": f"{type(e).__name__}: {e}",
            "latency_sec": time.time() - started,
        }
