# persMEM critic — systemd unit example
#
# PREREQUISITE: create a dedicated unprivileged user before installing this unit.
# The abliterated model runs with refusal directions ablated; defense-in-depth
# argues for the smallest possible blast radius. Run as a system user with no
# shell, no home directory, and read-only access to exactly the files the
# inference process needs.
#
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin \
#     --comment "persMEM critic (abliterated llama-server)" critic
#
# Then set group ownership and read-only permissions on the model + configs:
#
#   sudo chown -R root:critic /opt/persmem/models /opt/persmem/critic
#   sudo chmod -R g=rX,o= /opt/persmem/models /opt/persmem/critic
#   sudo chgrp -R critic /opt/persmem/llama.cpp/build/bin
#   sudo chmod g+rx /opt/persmem/llama.cpp/build/bin/llama-server
#
# Adjust paths if your install differs from /opt/persmem.

[Unit]
Description=persMEM critic model — abliterated reasoning LLM (Q8_0)
Documentation=https://github.com/ASIXicle/persMEM-plus
After=network.target

[Service]
Type=simple

# Dedicated unprivileged user (created via the useradd above).
# Defense-in-depth for an abliterated model — minimal blast radius even
# under hypothetical post-ablation behavior unlocks.
User=critic
Group=critic

WorkingDirectory=/opt/persmem
ExecStart=/opt/persmem/llama.cpp/build/bin/llama-server \
  --model /opt/persmem/models/your-abliterated-model-Q8_0.gguf \
  --host 127.0.0.1 \
  --port 8080 \
  --threads 3 \
  --ctx-size 8192 \
  --batch-size 256 \
  --n-predict 1024 \
  --no-warmup \
  --log-disable

# Resource hygiene — adjust to your hardware. Defaults sized for 24GB-cgroup
# LXC running ChromaDB on the same host. --ctx-size 8192 is critical: many
# reasoning models default to 256K context windows that exceed cgroup limits.
Nice=5
CPUSchedulingPolicy=batch
MemoryHigh=10G
MemoryMax=12G

# Restart policy — fail-soft, don't death-loop
Restart=on-failure
RestartSec=10
StartLimitInterval=300
StartLimitBurst=3

# ── Hardening (defense-in-depth) ──

# No privilege escalation possible
NoNewPrivileges=true
CapabilityBoundingSet=

# Filesystem isolation — strict means root filesystem is read-only except
# /dev, /proc, /sys, and any explicitly listed ReadWritePaths (none here).
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
UMask=0077

# Kernel/system isolation
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Process/namespace restrictions
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Syscall filter — allow system-service profile, deny privileged + resource ops
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Network: localhost only — blocks any outbound or non-local listener
IPAddressDeny=any
IPAddressAllow=127.0.0.1/8 ::1/128

# W^X — try this first; if llama-server crashes on start with SIGSYS or
# "operation not permitted" on mmap, comment out this single line and reload.
# Quantized matmul kernels MAY require executable+writable mappings on some
# llama.cpp builds. Tested OK on llama.cpp built without GPU support.
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
